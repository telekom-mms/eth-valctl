{
  "author": {
    "name": "TobiWo"
  },
  "bin": {
    "eth-valctl": "src/cli/main.ts"
  },
  "dependencies": {
    "@chainsafe/blst": "^2.2.0",
    "@ethereumjs/common": "^10.1.3",
    "@ethereumjs/tx": "^10.1.3",
    "@ledgerhq/errors": "^6.37.0",
    "@ledgerhq/hw-app-eth": "^7.8.18",
    "@ledgerhq/hw-transport-node-hid": "^6.33.5",
    "@safe-global/api-kit": "^4.2.0",
    "@safe-global/protocol-kit": "^7.2.0",
    "@safe-global/types-kit": "^3.1.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "ethers": "^6.17.0",
    "prompts": "^2.4.2",
    "undici": "^8.10.2"
  },
  "description": "CLI tool to manage Ethereum validators",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@eslint/migrate-config": "^2.1.0",
    "@ledgerhq/types-cryptoassets": "^7.39.0",
    "@ledgerhq/types-devices": "^6.32.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@types/bun": "^1.4.2",
    "@types/prompts": "^2.4.9",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "sort-package-json": "^3.7.1",
    "typescript": "^6.0.3"
  },
  "license": "MIT",
  "name": "eth-valctl",
  "overrides": {
    "axios": "1.20.0",
    "node-hid": "3.4.0"
  },
  "packageManager": "bun@1.3.12",
  "scripts": {
    "clean": "rm -rf bin dist",
    "format": "bunx prettier --write .",
    "format:check": "bunx prettier --check .",
    "lint": "bunx eslint . --ext .ts --fix",
    "package": "bun run scripts/package/package.ts",
    "postinstall": "bun run scripts/package/patch-native-modules.ts",
    "start": "bun run src/cli/main.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:coverage-diff": "bun run scripts/lint/coverage-diff.ts",
    "typecheck": "bun run --bun tsc --noEmit && echo \"\u2713 TypeScript compilation successful - no errors found\""
  },
  "type": "module",
  "version": "0.7.0"
}
